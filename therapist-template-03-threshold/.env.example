# Resend transactional email — used by the contact form Server Action.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that website inquiries are delivered to.
# This is the practitioner's monitored email address.
CONTACT_INBOX=

# The verified "from" sender Resend will send as (must be on a domain you
# verified in Resend, e.g. inquiries@yourpractice.com).
CONTACT_FROM=
